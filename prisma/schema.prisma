generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Story {
  id          String   @id @default(uuid())
  title       String
  level       String
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lyric {
  id          String   @id @default(uuid())
  title       String
  artist      String
  level       String?
  translation String?
  coverUrl    String?
  youtubeUrl  String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id          String   @id @default(uuid())
  title       String
  topic       String
  language    String   @default("ja")
  level       String?
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([language])
}

model Topic {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())
}

model Subtopic {
  id        String   @id @default(uuid())
  topicSlug String
  slug      String
  label     String
  createdAt DateTime @default(now())

  @@unique([topicSlug, slug])
}

model ExampleSentence {
  id            String   @id @default(uuid())
  topicSlug     String
  subtopicSlug  String
  sentenceIndex Int
  text          String
  furigana      String
  translation   String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([topicSlug, subtopicSlug, sentenceIndex])
  @@index([topicSlug, subtopicSlug])
}

model MangaVolume {
  id           String      @id
  title        String
  volumeNumber String?
  totalPages   Int?
  coverUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pages        MangaPage[]
}

model MangaPage {
  id            String          @id @default(uuid())
  volumeId      String
  volume        MangaVolume     @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  pageIndex     Int
  imageUrl      String
  imageChecksum String
  width         Int
  height        Int
  updatedAt     DateTime        @updatedAt
  dialogues     MangaDialogue[]

  @@unique([volumeId, pageIndex])
}

model MangaDialogue {
  id            String    @id @default(uuid())
  pageId        String
  page          MangaPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  dialogueIndex Int
  boxX          Int
  boxY          Int
  boxWidth      Int
  boxHeight     Int
  fullText      String
  tokens        String
  furigana      String
  morphology    String

  @@unique([pageId, dialogueIndex])
}

model MangaImageAsset {
  checksum  String   @id
  url       String
  createdAt DateTime @default(now())
}

model VocabularySet {
  id          String           @id @default(uuid())
  topic       String
  subtopic    String
  contentType String
  title       String
  coverUrl    String?
  // Admin override of the computed SDUI layout (JSON text of an SduiNode).
  // Null means "use the heuristic default" — see src/lib/sdui.ts.
  layout      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  pages       VocabularyPage[]
  words       VocabularyWord[]

  @@unique([topic, subtopic])
}

model VocabularyPage {
  id            String            @id @default(uuid())
  setId         String
  set           VocabularySet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  pageIndex     Int
  imageUrl      String
  imageChecksum String
  width         Int
  height        Int
  updatedAt     DateTime          @updatedAt
  entries       VocabularyEntry[]

  @@unique([setId, pageIndex])
}

model VocabularyEntry {
  id         String         @id @default(uuid())
  pageId     String
  page       VocabularyPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  entryIndex Int
  boxX       Int
  boxY       Int
  boxWidth   Int
  boxHeight  Int
  fullText   String
  tokens     String
  furigana   String
  morphology String

  @@unique([pageId, entryIndex])
}

model VocabularyImageAsset {
  checksum  String   @id
  url       String
  createdAt DateTime @default(now())
}

model VocabularyWord {
  id          String        @id @default(uuid())
  setId       String
  set         VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  wordIndex   Int
  term        String
  furigana    String
  translation String
  // Optional second form of the same word (e.g. causative/shieki vs. plain),
  // shown as a comparison column by the SDUI table heuristic. All three are
  // set together or not at all — see src/validators.ts.
  variantTerm     String?
  variantFurigana String?
  variantLabel    String?

  @@unique([setId, wordIndex])
}

// Overlay table for additional-language translations layered on top of the
// legacy (Spanish) translation columns/JSON above. blockId is "" for an
// item's own title-level translation, or a block's stable id otherwise.
model Translation {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  blockId    String   @default("")
  locale     String
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, blockId, locale])
  @@index([entityType, entityId])
}
