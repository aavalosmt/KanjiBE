generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Story {
  id          String   @id @default(uuid())
  title       String
  level       String
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lyric {
  id          String   @id @default(uuid())
  title       String
  artist      String
  level       String?
  translation String?
  coverUrl    String?
  youtubeUrl  String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id          String   @id @default(uuid())
  title       String
  topic       String
  level       String?
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
