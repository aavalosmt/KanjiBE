generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data/kanji.db"
}

model Story {
  id          String   @id @default(uuid())
  title       String
  level       String
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lyric {
  id          String   @id @default(uuid())
  title       String
  artist      String
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
