generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Story {
  id          String   @id @default(uuid())
  title       String
  level       String
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lyric {
  id          String   @id @default(uuid())
  title       String
  artist      String
  level       String?
  translation String?
  coverUrl    String?
  youtubeUrl  String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id          String   @id @default(uuid())
  title       String
  topic       String
  level       String?
  translation String?
  coverUrl    String?
  blocks      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Topic {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())
}

model MangaVolume {
  id           String      @id
  title        String
  volumeNumber String?
  totalPages   Int?
  coverUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  pages        MangaPage[]
}

model MangaPage {
  id            String          @id @default(uuid())
  volumeId      String
  volume        MangaVolume     @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  pageIndex     Int
  imageUrl      String
  imageChecksum String
  width         Int
  height        Int
  updatedAt     DateTime        @updatedAt
  dialogues     MangaDialogue[]

  @@unique([volumeId, pageIndex])
}

model MangaDialogue {
  id            String    @id @default(uuid())
  pageId        String
  page          MangaPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  dialogueIndex Int
  boxX          Int
  boxY          Int
  boxWidth      Int
  boxHeight     Int
  fullText      String
  tokens        String
  furigana      String
  morphology    String

  @@unique([pageId, dialogueIndex])
}

model MangaImageAsset {
  checksum  String   @id
  url       String
  createdAt DateTime @default(now())
}
